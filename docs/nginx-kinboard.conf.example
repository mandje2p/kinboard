# /etc/nginx/sites-available/kinboard  (then: ln -s into sites-enabled)
# Replace cuisine.example.fr with your sub-domain. Run certbot afterwards:
#   sudo certbot --nginx -d cuisine.example.fr
server {
    listen 80;
    listen [::]:80;
    server_name cuisine.example.fr;

    # Photos and attachments are uploaded through the app.
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Live updates (server-sent events / websockets) must not be buffered.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
